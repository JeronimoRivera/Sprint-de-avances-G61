rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && role() == 'administrador';
    }

    function isAccess() {
      return signedIn() && role() == 'acceso';
    }

    function validSpaceCapacity(spaceId, capacity) {
      return (spaceId == 'sala-a101' && capacity == 24)
        || (spaceId == 'sala-b204' && capacity == 18)
        || (spaceId == 'auditorio-central' && capacity == 120)
        || (spaceId == 'lab-redes' && capacity == 20)
        || (spaceId == 'lab-quimica' && capacity == 16)
        || (spaceId == 'lab-computo' && capacity == 30);
    }

    function expectedSlotId(data) {
      let parts = data.date.split('-');
      let hour = data.hour < 10
        ? '0' + string(data.hour)
        : string(data.hour);
      return data.spaceId + '_' + parts[0] + parts[1] + parts[2] + '_' + hour;
    }

    function validSlotFields(data, slotId) {
      return data.spaceId is string
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hour is int
        && data.hour >= 7
        && data.hour <= 19
        && slotId == expectedSlotId(data);
    }

    function slotMatchesReservation(slot, reservation, reservationId) {
      return slot.status == 'ocupada'
        && slot.reservationId == reservationId
        && slot.spaceId == reservation.spaceId
        && slot.date == reservation.date
        && slot.hour == reservation.hour;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'nombre', 'rol'])
        && request.resource.data.keys().hasOnly(['email', 'nombre', 'rol'])
        && request.resource.data.rol == 'usuario';
      allow update: if isOwner(userId)
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'nombre']);
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin() || isAccess());
      allow create: if signedIn()
        && role() == 'usuario'
        && request.resource.data.id == reservationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'SOLICITADA'
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.slotId == expectedSlotId(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'spaceId', 'slotId', 'spaceName', 'capacity', 'date',
          'hour', 'startAt', 'attendees', 'reason', 'status',
          'rejectReason', 'checkIn', 'checkOut', 'createdAt'
        ])
        && request.resource.data.hour is int
        && request.resource.data.hour >= 7
        && request.resource.data.hour <= 19
        && request.resource.data.startAt is timestamp
        && request.resource.data.startAt.year()
          == int(request.resource.data.date.split('-')[0])
        && request.resource.data.startAt.month()
          == int(request.resource.data.date.split('-')[1])
        && request.resource.data.startAt.day()
          == int(request.resource.data.date.split('-')[2])
        && request.resource.data.startAt.hours() == request.resource.data.hour
        && request.resource.data.startAt > request.time
        && request.resource.data.startAt.minutes() == 0
        && request.resource.data.startAt.seconds() == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.attendees is int
        && request.resource.data.capacity is int
        && validSpaceCapacity(
          request.resource.data.spaceId,
          request.resource.data.capacity
        )
        && request.resource.data.attendees >= 1
        && request.resource.data.attendees <= request.resource.data.capacity
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.rejectReason == null
        && request.resource.data.checkIn == null
        && request.resource.data.checkOut == null;
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid
          && role() == 'usuario'
          && resource.data.status in ['SOLICITADA', 'CONFIRMADA']
          && request.resource.data.status == 'CANCELADA'
          && request.time <= resource.data.startAt - duration.value(1, 'h')
          && (
            resource.data.status == 'SOLICITADA'
            || (
              getAfter(
                /databases/$(database)/documents/slots/$(resource.data.slotId)
              ).data.status == 'libre'
              && getAfter(
                /databases/$(database)/documents/slots/$(resource.data.slotId)
              ).data.reservationId == null
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        )
        || (
          isAdmin()
          && request.auth.uid != resource.data.userId
          && resource.data.status == 'SOLICITADA'
          && request.resource.data.status == 'CONFIRMADA'
          && request.time < resource.data.startAt
          && validSpaceCapacity(
            resource.data.spaceId,
            resource.data.capacity
          )
          && request.resource.data.attendees <= request.resource.data.capacity
          && request.resource.data.slotId == expectedSlotId(resource.data)
          && (
            !exists(
              /databases/$(database)/documents/slots/$(resource.data.slotId)
            )
            || get(
              /databases/$(database)/documents/slots/$(resource.data.slotId)
            ).data.status == 'libre'
          )
          && slotMatchesReservation(
            getAfter(
              /databases/$(database)/documents/slots/$(resource.data.slotId)
            ).data,
            resource.data,
            reservationId
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        )
        || (
          isAdmin()
          && request.auth.uid != resource.data.userId
          && resource.data.status == 'SOLICITADA'
          && request.resource.data.status == 'RECHAZADA'
          && request.resource.data.rejectReason is string
          && request.resource.data.rejectReason.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'rejectReason'])
        )
        || (
          isAccess()
          && resource.data.status == 'CONFIRMADA'
          && request.resource.data.status == 'EN_USO'
          && request.time >= resource.data.startAt
          && request.time < resource.data.startAt + duration.value(1, 'h')
          && request.resource.data.checkIn == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'checkIn'])
        )
        || (
          isAccess()
          && resource.data.status == 'EN_USO'
          && request.resource.data.status == 'FINALIZADA'
          && request.resource.data.checkOut == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'checkOut'])
        )
        || (
          isAccess()
          && resource.data.status == 'CONFIRMADA'
          && request.resource.data.status == 'AUSENTE'
          && request.time >= resource.data.startAt + duration.value(1, 'h')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        )
      );
      allow delete: if false;
    }

    match /slots/{slotId} {
      allow read: if signedIn();
      allow create, update: if (
        isAdmin()
        && request.resource.data.keys().hasAll([
          'spaceId', 'date', 'hour', 'status', 'reservationId'
        ])
        && validSlotFields(request.resource.data, slotId)
        && request.resource.data.status in ['bloqueada', 'libre', 'ocupada']
        && (
          (
            request.resource.data.status == 'bloqueada'
            && request.resource.data.reservationId == null
            && (
              !exists(/databases/$(database)/documents/slots/$(slotId))
              || resource.data.status == 'libre'
            )
          )
          || (
            request.resource.data.status == 'libre'
            && resource.data.status == 'bloqueada'
            && request.resource.data.reservationId == null
          )
          || (
            request.resource.data.status == 'ocupada'
            && request.resource.data.reservationId is string
            && (
              !exists(/databases/$(database)/documents/slots/$(slotId))
              || resource.data.status == 'libre'
            )
            && get(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.status == 'SOLICITADA'
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.status == 'CONFIRMADA'
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.slotId == slotId
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.spaceId == request.resource.data.spaceId
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.date == request.resource.data.date
            && getAfter(
              /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
            ).data.hour == request.resource.data.hour
          )
        )
      )
        || (
          signedIn()
          && role() == 'usuario'
          && resource.data.status == 'ocupada'
          && request.resource.data.status == 'libre'
          && request.resource.data.reservationId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reservationId'])
          && getAfter(
            /databases/$(database)/documents/reservations/$(resource.data.reservationId)
          ).data.status == 'CANCELADA'
          && getAfter(
            /databases/$(database)/documents/reservations/$(resource.data.reservationId)
          ).data.userId == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/reservations/$(resource.data.reservationId)
          ).data.slotId == slotId
        );
      allow delete: if false;
    }
  }
}
